# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/.local-tools/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated registration and local credentials
.packages
lib/generated_plugin_registrant.dart
**/key.properties
**/*.keystore
**/*.jks

# Private credentials: keep real values local; only sanitized templates belong in Git.
.env
.env.*
!.env.example
!.env.template
**/credentials.json
**/*-credentials.json
**/application_default_credentials.json
**/service-account*.json
**/service_account*.json
**/*serviceAccount*.json
**/secrets.json
.secrets/
**/secrets/
**/*.key
**/*.p12
**/*.pfx
**/*.pem

# Distribution binaries belong in local build/release folders, never source control.
*.apk
*.aab
*.ipa

# Unused platform scaffolding generated locally during Android development.
/linux/
/macos/
/windows/
/ios/RunnerTests/

# Unused local experiments and temporary files.
/lib/writeFile_fixed.dart
/lib/writeFile_new.dart
/scratch/
/tmp/
/temp/
*.tmp
*.bak
*.orig
*.rej

# Local screenshots are not project source.
**/screenshots/
screenshot*.png
screenshot*.jpg
